# Copy this file to .env and fill in the values. Never commit .env.

# --- Gnani Speech APIs (Prisma STT, Timbre TTS) ---
# Get it from https://app.gnani.ai/voice -> API Keys
GNANI_SPEECH_API_KEY=
GNANI_SPEECH_BASE_URL=https://api.vachana.ai

# --- Gnani Agent Builder Platform API ---
# Agent Builder console -> Settings -> API Keys (permissions: agents, conversations)
GNANI_PLATFORM_API_KEY=
GNANI_PLATFORM_BASE_URL=https://api.inya.ai/platform
GNANI_ENVIRONMENT=development
# Filled in automatically by scripts/setup_agent.py
GNANI_BOT_ID=

# --- Backend LLM (voice-note extraction, daily briefing text, call summaries) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# --- Database ---
# Local: SQLite. Production: Neon Postgres connection string.
DATABASE_URL=sqlite:///./janani.db

# --- Public app URL (used for the post-call webhook) ---
PUBLIC_BASE_URL=
WEBHOOK_SECRET=

# --- Demo phone numbers (10 digits, must be whitelisted in Agent Builder) ---
DEMO_ASHA_PHONE=
DEMO_BENEFICIARY_PHONE=
