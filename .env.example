# Copy this file to .env and fill in the values. Never commit .env.

# --- Gnani Speech APIs (Prisma STT, Timbre TTS) ---
# Get it from https://app.gnani.ai/voice -> API Keys
GNANI_SPEECH_API_KEY=
GNANI_SPEECH_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Chetana

# --- Gemini (conversation reasoning, call review, note extraction, briefing text) ---
# Get it from https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite

# --- Database ---
# Local: SQLite (default). Production: Neon Postgres connection string.
DATABASE_URL=

# --- App ---
ASHA_NAME=Asha didi
